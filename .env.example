# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
AI_MOCK_MODE=false

# Limits
ANONYMOUS_DAILY_LIMIT=3
MAX_PROMPT_CHARS=12000
MIN_PROMPT_CHARS=20

# Sensitive data detection
SENSITIVE_DATA_BLOCK_HIGH_RISK=true
SENSITIVE_DATA_STORE_FINDINGS=true

# Versions
ANALYSIS_SCHEMA_VERSION=1.0.0
SCORING_VERSION=1.0.0
PROMPT_TEMPLATE_VERSION=1.0.0

# Local starter behavior
NEXT_PUBLIC_ENABLE_MOCK_RESULT=true

# Stripe Billing Configuration
# Set STRIPE_ENABLED=true only when Stripe is fully configured and billing tables are created.
# Keep STRIPE_ENABLED=false during beta / simulated-pro mode to avoid PGRST205 errors.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=

# Data Retention Policies (in days)
RETENTION_ANONYMOUS_ANALYSIS_DAYS=30
RETENTION_USAGE_EVENT_DAYS=90
RETENTION_FEEDBACK_EVENT_DAYS=180

# Administrative / Operational Control
CRON_SECRET=
ADMIN_EMAILS=

# Rate Limiting
# HMAC-SHA256 secret used to pseudonymize IP addresses for rate limiting.
# Required in production (checked by checkProductionEnv).
RATE_LIMIT_HMAC_SECRET=

# AI Provider Timeout
# Milliseconds before an AI provider request is aborted. Default: 30000 (30s). Min: 1000, Max: 60000.
AI_PROVIDER_TIMEOUT_MS=30000
